<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical in portrait, horizontal in landscape. MeasurementActivity.applyOrientation swaps
     the orientation and the two children's layout params directly, so configChanges keeps the
     Activity alive and the camera and model are never reloaded on rotation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_preview">

    <FrameLayout
        android:id="@+id/previewWrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- fitCenter must stay in sync with OverlayView, which reproduces the same mapping
             to place detection boxes. -->
        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/preview_description" />

        <com.example.activeperception.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/statusText"
            style="@style/PreviewOverlayText"
            android:text="@string/status_initial"
            android:textColor="@color/text_primary"
            android:layout_gravity="top|start" />

        <!-- ISO + exposure of the cell that produced the frame on screen. -->
        <TextView
            android:id="@+id/cellText"
            style="@style/PreviewOverlayText"
            android:text="@string/cell_readout_empty"
            android:textColor="@color/text_readout"
            android:fontFamily="monospace"
            android:layout_gravity="top|end" />

        <!-- auto_collect: what is running now, in letters readable from across the room,
             a small progress line under it, and the three steps. Pressing the running
             step's button again stops it. -->
        <LinearLayout
            android:id="@+id/expPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FF000000"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="experiments"
                    android:textColor="@color/text_label"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/expClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="manual"
                    android:textAllCaps="false"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView android:id="@+id/expNow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:text="ready"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="120sp" />

            <TextView android:id="@+id/expStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_label"
                android:textSize="16sp" />

            <!-- Limo speed: the operator's pick of slow / avg / fast (kept until changed,
                 written into every run's manifest like the lighting; tap the lit one to
                 clear it), and the last run's lap time measured from the gyro (also in
                 every run's summary.json). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limo speed"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <Button android:id="@+id/limoSlow"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="slow" android:textAllCaps="false" android:textSize="15sp" android:maxLines="1"
                    android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
                <Button android:id="@+id/limoAvg"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="avg" android:textAllCaps="false" android:textSize="15sp" android:maxLines="1"
                    android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
                <Button android:id="@+id/limoFast"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="fast" android:textAllCaps="false" android:textSize="15sp" android:maxLines="1"
                    android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
                <TextView android:id="@+id/limoMeasured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="lap —"
                    android:textColor="@color/text_label"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Tabs: Main = the Duel experiment, one press per lighting; Check = short
                 checks before it; Old = earlier experiments' steps, kept startable. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <Button android:id="@+id/expTabMain"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Main"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:textSize="17sp" />
                <Button android:id="@+id/expTabCheck"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Check"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:textSize="17sp" />
                <Button android:id="@+id/expTabRecord"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Record"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/expRowMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <Button android:id="@+id/expMainBright"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:text="bright"
                    android:textAllCaps="false"
                    android:textSize="22sp" />
                <Button android:id="@+id/expMainDim"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="dim"
                    android:textAllCaps="false"
                    android:textSize="22sp" />
                <Button android:id="@+id/expMainDark"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="dark"
                    android:textAllCaps="false"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/expRowCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">
                <Button android:id="@+id/expReadNoise"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="read
noise"
                    android:textAllCaps="false"
                    android:minWidth="0dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:textSize="18sp" />
                <Button android:id="@+id/expVerifyDim"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="verify
dim"
                    android:textAllCaps="false"
                    android:minWidth="0dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:textSize="18sp" />
                <Button android:id="@+id/expVerifyDark"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="verify
dark"
                    android:textAllCaps="false"
                    android:minWidth="0dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Record: the counterfactual record (collect_cf, 225 moments) per lighting. -->
            <LinearLayout android:id="@+id/expRowRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">
                <Button android:id="@+id/expRecordBright"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:text="bright"
                    android:textAllCaps="false"
                    android:textSize="22sp" />
                <Button android:id="@+id/expRecordDim"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="dim"
                    android:textAllCaps="false"
                    android:textSize="22sp" />
                <Button android:id="@+id/expRecordDark"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="dark"
                    android:textAllCaps="false"
                    android:textSize="22sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Scrollable because the stacked controls exceed the available height in landscape.
         controlsInner is padded by the window-inset listener in MeasurementActivity. -->
    <ScrollView
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_controls"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/controlsInner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/touchpadHelp"
                style="@style/SectionLabel"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="3dp"
                android:text="@string/touchpad_help"
                android:textColor="@color/text_readout"
                android:textSize="10sp" />

            <!-- Session preset: shifts the v2 gain-ladder anchor (indoor / walk /
                 vehicle-night / vehicle-day). Read at run start; also settable via
                 the "session" string intent extra for adb-driven devices. -->
            <LinearLayout
                android:id="@+id/sessionRow"
                style="@style/OptionRow"
                android:gravity="center_vertical"
                android:layout_marginTop="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session:"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <Spinner android:id="@+id/sessionSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp" />
            </LinearLayout>

            <!-- Method, two linked rows (the Activity makes them one exclusive choice).
                 AE strategies are flattened into distinct methods so a run's arm is
                 chosen - and visible - in one place, with no nested strategy group. -->
            <RadioGroup
                android:id="@+id/methodGroup"
                style="@style/OptionRow"
                android:layout_marginTop="0dp">

                <RadioButton android:id="@+id/methodAePhone"
                    style="@style/Option.Narrow" android:text="AE-Phone" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/methodGroup2"
                style="@style/OptionRow"
                android:layout_marginTop="0dp">

                <RadioButton android:id="@+id/methodContinuous"
                    style="@style/Option.Narrow" android:text="Sense-well"
                    android:checked="true" />
                <RadioButton android:id="@+id/methodPhysSweep"
                    style="@style/Option.Narrow" android:text="PhysSweep" />
                <RadioButton android:id="@+id/methodShinNM"
                    style="@style/Option.Narrow" android:text="ShinNM" />
                <RadioButton android:id="@+id/methodNeuralAe"
                    style="@style/Option.Narrow" android:text="NeuralAE" />
            </RadioGroup>

            <!-- Multiplies every virtually formed cell. Raw captures are written unboosted, so
                 divide it out before comparing pixels across the virtual/physical boundary. -->
            <TextView style="@style/SectionLabel" android:text="@string/label_digital_boost" />

            <RadioGroup
                android:id="@+id/boostGroup"
                style="@style/OptionRow">

                <RadioButton android:id="@+id/boost1x"
                    style="@style/Option" android:text="@string/boost_1x" />
                <RadioButton android:id="@+id/boost2x"
                    style="@style/Option" android:text="@string/boost_2x"
                    android:checked="true" />
                <RadioButton android:id="@+id/boost4x"
                    style="@style/Option" android:text="@string/boost_4x" />
            </RadioGroup>

            <!-- Operating cutoff for sum_conf and for Proposed's selection. The detector always
                 floors at 0.01; this only decides what counts as a real detection. -->
            <LinearLayout
                style="@style/OptionRow"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView style="@style/SectionLabel"
                    android:text="@string/label_conf_threshold"
                    android:layout_marginTop="0dp"
                    android:paddingEnd="6dp" />

                <Spinner android:id="@+id/confThreshSpinner"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp" />
            </LinearLayout>

            <!-- Sense-well only. -->
            <LinearLayout
                android:id="@+id/proposedSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Every Nth step probes the full grid; the rest probe the gain column. -->
                <TextView style="@style/SectionLabel" android:text="@string/label_period" />

                <RadioGroup
                    android:id="@+id/periodGroup"
                    style="@style/OptionRow">

                    <RadioButton android:id="@+id/period5"
                        style="@style/Option" android:text="@string/period_5"
                        android:checked="true" />
                    <RadioButton android:id="@+id/period10"
                        style="@style/Option" android:text="@string/period_10" />
                    <RadioButton android:id="@+id/period20"
                        style="@style/Option" android:text="@string/period_20" />
                </RadioGroup>

            </LinearLayout>

            <!-- Start runs whichever method is selected above; the second row holds the modes
                 that take no parameters. -->
            <LinearLayout
                style="@style/OptionRow"
                android:layout_marginTop="6dp">

                <Button android:id="@+id/btnStart" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="3"
                    android:text="@string/btn_start" android:textSize="13sp" />

                <Button android:id="@+id/btnStop" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/btn_stop" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/OptionRow"
                android:layout_marginTop="4dp">

                <Button android:id="@+id/btnOpenExp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="experiments"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Lap-driven collection: one press runs the whole plan while the vehicle
                 keeps circling (LapSession.kt). The label doubles as its status line. -->
            <Button android:id="@+id/btnLapSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lap session"
                android:textSize="13sp" />







        </LinearLayout>
    </ScrollView>

</LinearLayout>
